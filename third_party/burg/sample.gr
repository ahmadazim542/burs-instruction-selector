%{
#include <stdio.h>
#include <stdlib.h>

typedef struct node *NODEPTR_TYPE;

struct node {
	int op, state_label;
	NODEPTR_TYPE left, right;
};

#define OP_LABEL(p)	((p)->op)
#define STATE_LABEL(p)	((p)->state_label)
#define LEFT_CHILD(p)	((p)->left)
#define RIGHT_CHILD(p)	((p)->right)
#define PANIC		printf
%}

%start reg
%term Assign=1 Constant=2 Fetch=3 Four=4 Mul=5 Plus=6
%%
con:  Constant                = 1 (0);
con:  Four                    = 2 (0);
addr: con                     = 3 (0);
addr: Plus(con,reg)           = 4 (0);
addr: Plus(con,Mul(Four,reg)) = 5 (0);
reg:  Fetch(addr)             = 6 (1);
reg:  Assign(addr,reg)        = 7 (1);

%%

#define Assign 1
#define Constant 2
#define Fetch 3
#define Four 4
#define Mul 5
#define Plus 6

static const char *const sample_opname[] = {
	0, "Assign", "Constant", "Fetch", "Four", "Mul", "Plus"
};

static const unsigned char sample_arity[] = {
	0, 2, 0, 1, 0, 2, 2
};

static const char *const sample_rule[] = {
	0,
	"con: Constant",
	"con: Four",
	"addr: con",
	"addr: Plus(con,reg)",
	"addr: Plus(con,Mul(Four,reg))",
	"reg: Fetch(addr)",
	"reg: Assign(addr,reg)"
};

static const int sample_cost[] = {
	0, 0, 0, 0, 0, 0, 1, 1
};

NODEPTR_TYPE buildtree(int, NODEPTR_TYPE, NODEPTR_TYPE);
void printcover(NODEPTR_TYPE, int, int);
void printtree(NODEPTR_TYPE);
int treecost(NODEPTR_TYPE, int);
void printMatches(NODEPTR_TYPE);
int main(void);

NODEPTR_TYPE buildtree(int op, NODEPTR_TYPE left, NODEPTR_TYPE right) {
	NODEPTR_TYPE p;

	p = (NODEPTR_TYPE) malloc(sizeof *p);
	p->op = op;
	p->left = left;
	p->right = right;
	return p;
}

void printcover(NODEPTR_TYPE p, int goalnt, int indent) {
	int eruleno = burm_rule(STATE_LABEL(p), goalnt);
	short *nts = burm_nts[eruleno];
	NODEPTR_TYPE kids[10];
	int i;
	
	if (eruleno == 0) {
		printf("no cover\n");
		return;
	}
	for (i = 0; i < indent; i++)
		printf(".");
	printf("%s\n", sample_rule[eruleno]);
	burm_kids(p, eruleno, kids);
	for (i = 0; nts[i]; i++)
		printcover(kids[i], nts[i], indent+1);
}

void printtree(NODEPTR_TYPE p) {
	int op = OP_LABEL(p);

	printf("%s", sample_opname[op]);
	switch (sample_arity[op]) {
	case 0:
		break;
	case 1:
		printf("(");
		printtree(LEFT_CHILD(p));
		printf(")");
		break;
	case 2:
		printf("(");
		printtree(LEFT_CHILD(p));
		printf(", ");
		printtree(RIGHT_CHILD(p));
		printf(")");
		break;
	}
}

int treecost(NODEPTR_TYPE p, int goalnt) {
	int eruleno = burm_rule(STATE_LABEL(p), goalnt);
	int cost = sample_cost[eruleno], i;
	short *nts = burm_nts[eruleno];
	NODEPTR_TYPE kids[10];

	burm_kids(p, eruleno, kids);
	for (i = 0; nts[i]; i++)
		cost += treecost(kids[i], nts[i]);
	return cost;
}

void printMatches(NODEPTR_TYPE p) {
	int nt;
	int eruleno;

	printf("Node 0x%p= ", p);
	printtree(p);
	printf(" matched rules:\n");
	for (nt = 1; nt <= burm_NT; nt++)
		if ((eruleno = burm_rule(STATE_LABEL(p), nt)) != 0)
			printf("\t%s\n", sample_rule[eruleno]);
}

int main(void) {
	NODEPTR_TYPE p;

	p = buildtree(Assign,
		buildtree(Constant, 0, 0),
		buildtree(Fetch,
			buildtree(Plus,
				buildtree(Constant, 0, 0),
				buildtree(Mul,
					buildtree(Four, 0, 0),
					buildtree(Fetch, buildtree(Constant, 0, 0), 0)
				)
			),
			0
		)
	);
	printtree(p);
	printf("\n\n");
	burm_label(p);
	printcover(p, 1, 0);
	printf("\nCover cost == %d\n\n", treecost(p, 1));
	printMatches(p);
	return 0;
}

